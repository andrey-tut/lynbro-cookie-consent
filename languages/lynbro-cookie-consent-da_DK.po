msgstr "(åbner i en ny fane)"

#: includes/lynbro-core/lynbro-core.php:1363
msgid "Share feedback"
msgstr "Giv feedback"

#: includes/lynbro-core/lynbro-core.php:1365
msgid "Maybe later"
msgstr "Måske senere"

#: includes/lynbro-core/lynbro-core.php:1366
msgid "Don't ask again"
msgstr "Spørg ikke igen"

#: includes/lynbro-core/lynbro-core.php:1369
msgid "Something not working? Ask for help"
msgstr "Virker noget ikke? Få hjælp"

