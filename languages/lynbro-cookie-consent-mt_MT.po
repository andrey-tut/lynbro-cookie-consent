msgstr "Ikona tal-buttuna"

msgid "Button text"
msgstr "Test tal-buttuna"

msgid "Button text on Accept button"
msgstr "Test fuq il-buttuna Aċċetta"

msgid "Button text on Reject button"
msgstr "Test fuq il-buttuna Irrifjuta"

msgid "CCPA / CPRA opt-out link"
msgstr "Link ta’ opt-out għall-CCPA / CPRA"

msgid "Categories"
msgstr "Kategoriji"

msgid "Category"
msgstr "Kategorija"

msgid "Category “%s” — description"
msgstr "Kategorija “%s” — deskrizzjoni"

msgid "Category “%s” — name"
msgstr "Kategorija “%s” — isem"

msgid "Center modal (with overlay)"
msgstr "Tieqa modali fiċ-ċentru (b’overlay)"

