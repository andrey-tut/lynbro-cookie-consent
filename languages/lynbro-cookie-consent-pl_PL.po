msgstr "Rejestr zgód"

msgid "Consent Mode"
msgstr "Tryb zgody"

msgid "Consent Mode v2"
msgstr "Consent Mode v2"

msgid "Consent logging is disabled."
msgstr "Rejestrowanie zgód jest wyłączone."

msgid "Consent mode"
msgstr "Tryb zgody"

msgid "Content from %s is blocked"
msgstr "Treści z %s są zablokowane"

