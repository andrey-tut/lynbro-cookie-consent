msgstr "Záznam souhlasů"

msgid "Consent Mode"
msgstr "Consent Mode"

msgid "Consent Mode v2"
msgstr "Consent Mode v2"

msgid "Consent logging is disabled."
msgstr "Záznam souhlasů je vypnutý."

msgid "Consent mode"
msgstr "Režim souhlasu"

