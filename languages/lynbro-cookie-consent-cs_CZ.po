msgstr "Záznam souhlasů"

msgid "Consent Mode"
msgstr "Režim souhlasu"

msgid "Consent Mode v2"
msgstr "Režim souhlasu v2"

msgid "Consent logging is disabled."
msgstr "Zaznamenávání souhlasů je vypnuto."

msgid "Consent mode"
msgstr "Režim souhlasu"

