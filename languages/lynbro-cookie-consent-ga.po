msgstr "Na 7 lá seo caite"

msgid "Leave a review"
msgstr "Fág léirmheas uait"

msgid "Leave empty to use the Accept button color."
msgstr "Fág bán é chun dath an chnaipe Glac a úsáid."

msgid "Leave empty to use the Button text color."
msgstr "Fág bán é chun dath téacs an chnaipe a úsáid."

msgid "Leave empty to use the translated default."
msgstr "Fág bán é chun an réamhshocrú aistrithe a úsáid."

