msgid ""
"Shared Lynbro components v%1$s, provided by %2$s (newest of %3$d versions on"
" this site)."
msgstr ""
"Komponenti Lynbro maqsuma v%1$s, ipprovduti minn %2$s (l-aktar ġdida minn "
"%3$d verżjonijiet fuq dan is-sit)."

