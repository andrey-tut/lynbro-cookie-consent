msgstr "Illum"

msgid "Too many requests."
msgstr "Wisq talbiet."

msgid "Tools"
msgstr "Għodod"

msgid "Top bar"
msgstr "Strixxa ta' fuq"

msgid "Top left"
msgstr "Fuq ix-xellug"

msgid "Top right"
msgstr "Fuq il-lemin"

