msgstr "Knappikon"

msgid "Button text"
msgstr "Knapptext"

msgid "Button text on Accept button"
msgstr "Knapptext på knappen Acceptera"

msgid "Button text on Reject button"
msgstr "Knapptext på knappen Avvisa"

msgid "CCPA / CPRA opt-out link"
msgstr "Länk för att välja bort enligt CCPA/CPRA"

msgid "Categories"
msgstr "Kategorier"

