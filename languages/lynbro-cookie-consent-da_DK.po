msgid "Hide details"
msgstr "Skjul detaljer"

#: admin/settings.php:119
msgid ""
"Apply this design preset? It will overwrite your current Design settings "
"(you can still review before saving)."
msgstr ""
"Anvend denne forudindstilling for design? Den overskriver dine nuværende "
"designindstillinger (du kan stadig gennemgå dem, før du gemmer)."

#: admin/settings.php:120
msgid "Preset applied. Review the preview, then Save Changes to keep it."
msgstr ""
"Forudindstillingen er anvendt. Gennemse forhåndsvisningen, og vælg derefter "
"Gem ændringer for at beholde den."

#: admin/settings.php:146
msgid "Full-width bar at the bottom, light and neutral."
msgstr "Bjælke i fuld bredde nederst, lys og neutral."

#: admin/settings.php:162
msgid "Soft floating card in the bottom-right corner."
msgstr "Blødt, svævende kort i nederste højre hjørne."

#: admin/settings.php:179
msgid "Centered dialog with a dimmed overlay, dark theme."
msgstr "Centreret dialog med nedtonet overlejring, mørkt tema."

#: admin/settings.php:195
msgid "Slim, square bar pinned to the top of the page."
msgstr "Smal, firkantet bjælke, der er fastgjort øverst på siden."

#: admin/settings.php:211
msgid "Calm, low-contrast palette in a rounded corner box."
msgstr "Rolig palet med lav kontrast i en boks med afrundede hjørner."

