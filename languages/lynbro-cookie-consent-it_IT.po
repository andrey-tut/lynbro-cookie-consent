msgstr "https://plugins.lynbro.dk/lynbro-cookie-consent"

msgid ""
"Free, multilingual, fully configurable cookie consent banner — GDPR/ePrivacy"
" and Google Consent Mode v2 ready, with no pageview limits."
msgstr ""
"Banner di consenso cookie gratuito, multilingue e completamente "
"configurabile — conforme a GDPR/ePrivacy e Google Consent Mode v2, senza "
"limiti di visualizzazioni."

msgid "Lynbro"
msgstr "Lynbro"

msgid "https://lynbro.dk"
msgstr "https://lynbro.dk"

msgid "Image Optimizer"
msgstr "Ottimizzatore Immagini"

msgid ""
"Convert to WebP and AVIF, right-size oversized images and lazy-load them — "
"all on your own server."
msgstr ""
"Converti in WebP e AVIF, ridimensiona le immagini troppo grandi e caricale "
"in modo differito — tutto sul tuo server."

msgid "AI Studio"
msgstr "AI Studio"

msgid ""
"Write and illustrate posts with AI on your own OpenAI key — at cost, with no"
" credits in between."
msgstr ""
"Scrivi e illustra post con l’AI usando la tua chiave OpenAI — al costo, "
"senza crediti intermedi."

