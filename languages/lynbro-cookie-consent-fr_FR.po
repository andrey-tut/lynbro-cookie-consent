msgstr "Actif"

msgid "Installed"
msgstr "Installé"

msgid "On WordPress.org"
msgstr "Sur WordPress.org"

msgid "Coming soon"
msgstr "Bientôt disponible"

msgid "Activate"
msgstr "Activer"

